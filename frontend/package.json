{
  "name": "rare-frontend",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration=rare --port=4000",
    "start:rare": "ng serve --configuration=rare --port=4000",
    "start:brc4env": "ng serve --configuration=brc4env --port=4000",
    "start:wheatis": "ng serve --configuration=wheatis --port=4100",
    "start:wheatis-production": "ng serve --configuration=wheatis-production --port=4101",
    "start:faidare": "ng serve --configuration=faidare --port=4200",
    "build": "ng build --configuration=production,rare-production --no-progress",
    "build:rare": "ng build --configuration=production,rare-production --no-progress",
    "build:brc4env": "ng build --configuration=production,brc4env-production --no-progress",
    "build:wheatis": "ng build --configuration=production,wheatis-production --no-progress",
    "build:faidare": "ng build --configuration=production,faidare-production --no-progress",
    "test": "ng test --no-watch",
    "lint": "mkdir -p build && ng lint > build/eslint-result.txt",
    "e2e": "ng e2e --ui",
    "e2e:standalone": "ng e2e",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "npx knip --fix-type exports,types --exclude dependencies,unlisted,files,binaries --tags=knipignore",
    "playwright-install": "pnpm exec playwright install",
    "playwright-install-deps": "pnpm exec playwright install-deps"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/localize": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@ng-bootstrap/ng-bootstrap": "21.0.0",
    "@ngx-translate/core": "18.0.0",
    "@popperjs/core": "2.11.8",
    "bootstrap": "5.3.8",
    "font-awesome": "4.7.0",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "marked": "18.1.1",
    "ngx-markdown": "22.1.1",
    "prismjs": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.6.0",
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/eslint-plugin": "1.6.28",
    "@vitest/spy": "5.0.5",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "oxfmt": "0.74.0",
    "playwright": "1.64.1",
    "playwright-ng-schematics": "22.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
